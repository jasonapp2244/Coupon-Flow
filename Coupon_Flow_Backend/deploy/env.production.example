# Production settings for SiteGround. Copy to .env on the server and fill every <…> value.
# Never commit or upload the filled-in file anywhere else.

APP_NAME="Urban Goods Guide"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://<api-domain>

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Daily files, kept 14 days; only warnings and errors.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Site Tools > Site > MySQL
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=<db-name>
DB_USERNAME=<db-user>
DB_PASSWORD=<db-password>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Site Tools > Email > Accounts (SMTP host: the SiteGround server name from the mailbox settings, e.g. giowm1084.siteground.biz: its certificate is valid and it keeps working when the domain itself points to another server; port 465, SSL). The From address must
# be on your domain so SPF/DKIM pass and staff emails don't land in spam.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=giowm1084.siteground.biz
MAIL_PORT=465
MAIL_USERNAME=info@urbangoodsguide.com
MAIL_PASSWORD=<mailbox-password>
MAIL_FROM_ADDRESS="info@urbangoodsguide.com"
MAIL_FROM_NAME="${APP_NAME}"

# The two frontends (exact origins, https, no trailing slash): used for CORS and email links.
FRONTEND_URL=https://<site-domain>
ADMIN_URL=https://<admin-domain>

# First admin account, created with: php artisan db:seed --class=AdminSeeder --force
ADMIN_EMAIL=faizan@urbangoodsguide.com
ADMIN_PASSWORD=<strong-password>
